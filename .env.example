# ────────────────────────────────────────────────────────────────
# Aircargo secrets — copy this file to `.env` and fill in real values.
# `.env` is gitignored: NEVER commit it.
#
#   cp .env.example .env
#   JWT_SECRET:        openssl rand -base64 64
# ────────────────────────────────────────────────────────────────

# ── JWT (min 32 chars, generate with: openssl rand -base64 64) ──
JWT_SECRET=change-me-openssl-rand-base64-64

# ── PostgreSQL ────────────────────────────────────────────────────
# POSTGRES_HOST: DÉJALO COMENTADO en local (localhost).
#   En un servidor: host del Postgres (ej. RDS endpoint, o "postgres"
#   si corre como Service de k8s — ver k8s/configmap.yml).
#POSTGRES_HOST=
POSTGRES_DB=aircargo
POSTGRES_USER=aircargo_user
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# ── RabbitMQ (matches docker/docker-compose.infrastructure.yml) ──
RABBITMQ_USER=aircargo
RABBITMQ_PASSWORD=change-me
# Consumidor AMQP de auditoría del auth-service (Fase 3). false = auth no consume audit.log
RABBITMQ_ENABLED=true

# ── Ports (host) ──────────────────────────────────
FRONTEND_PORT=5173
BACKEND_PORT=8080

# ── CORS (comma-separated origins; en producción: tu dominio https) ──
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Java heap ─────────────────────────────────────────────
# Dos estrategias (elige una según el entorno):
#   1. Tamaño FIJO por JVM (predecible en instancias pequeñas como t3.small:
#      10 JVM × ~256-512m ≈ 2-3 GB). Recomendado en EC2 nativo.
#        JAVA_OPTS="-Xms256m -Xmx512m"
#   2. RAM-aware (container/cgroups): proporcional a la memoria del sistema,
#      exactamente como usan los Dockerfiles/k8s (75%). Recomendado en
#      contenedores; en EC2 nativo requiere cgroup v2 de systemd.
#        JAVA_OPTS="-XX:MaxRAMPercentage=75"
# Un solo valor variable: NOTA — si defines RAM en JAVA_OPTS recuerda que
# start-all.sh y start-backend.sh lo propagan a TODAS las JVM.
JAVA_OPTS="-Xms256m -Xmx512m"

# ── Cifrado en reposo (mfaSecret/cédulas/firmas) ──────────────
# openssl rand -base64 32
APP_ENCRYPTION_KEY=change-me-openssl-rand-base64-32

# ── MFA (obligatorio) — política de re-enrolamiento ─────────────────
# APP_MFA_MANDATORY: MFA obligatorio para TODOS los usuarios (sin MFA no hay
#   sesión). Default=true (política de negocio). NO lo apagues en producción:
#   solo desactivar en entornos de prueba. Tests lo sobreescriben a false.
#APP_MFA_MANDATORY=true
# MFA_RESET_ON_STARTUP: en CADA arranque del auth-service ¿forzar a todos
#   los usuarios a re-enrolar su MFA? Default=true (seguro por defecto).
#   ⚠ EN PRODUCCIÓN usa false: evita que cada deploy/reinicio obligue a
#   reconfigurar el 2FA a todos los usuarios. En PRODUCCION la rotación la
#   gobierna MFA_MAX_AGE_DAYS (p.ej. re-enrolar si el MFA tiene >7 días).
#       local/staging:  true  (entornos controlados / invalidación deliberada)
#       produccion:     false (rec. — no interrumpir a usuarios reales)
#MFA_RESET_ON_STARTUP=false
#MFA_MAX_AGE_DAYS=7

# ── Copia OFFSITE de backups (protege ante fallo de disco) ────────────
# Prefijo rsync: → disco externo/NAS montado.  Prefijo rclone: → nube (rclone config primero).
# Dejar vacío para desactivar.
#BACKUP_OFFSITE_TARGET=rsync:/mnt/usb/aircargo-backups
#BACKUP_OFFSITE_TARGET=rclone:gdrive:aircargo-backups

# ── Redis (opcional — solo necesario en HA: 2+ réplicas) ─────────────
# Sin Redis todo funciona igual (rate-limit y caché en memoria, por instancia).
# Con Redis compartido: RATE_LIMIT_USE_REDIS=true + SPRING_CACHE_TYPE=redis en los servicios.
REDIS_HOST=localhost
REDIS_PORT=6379
RATE_LIMIT_USE_REDIS=false
# Límite por usuario autenticado (la UI dispara ráfagas + polling). Anónimos: 10/min por IP.
RATE_LIMIT_PER_MINUTE=600

# ── Herramientas BI (Looker Studio / Apache Superset) ────────────────
# Rol de SOLO LECTURA en Postgres para conexión directa (Superset, Looker
# Studio con conector nativo, Power BI, etc.). Crearlo/actualizarlo con:
#     ./scripts/configure-bi-reader.sh
# Si BI_READER_PASSWORD queda vacío, el script genera una y te la imprime
# (pégala aquí después para que las re-ejecuciones usen la misma).
#BI_READER_PASSWORD=
#BI_READER_ROLE=bi_reader
#
# Admin TCP para el script (opcional; por defecto usa POSTGRES_USER/PASSWORD).
# Solo necesario si POSTGRES_USER no puede crear roles.
#POSTGRES_ADMIN_USER=
#POSTGRES_ADMIN_PASSWORD=
#
# Apache Superset (opcional) — usado por docker/docker-compose.superset.yml.
# openssl rand -base64 42
#SUPERSET_SECRET_KEY=change-me-openssl-rand-base64-42
#SUPERSET_ADMIN_USER=admin
#SUPERSET_ADMIN_PASSWORD=change-me
